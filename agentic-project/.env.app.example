# .env for docker-compose.app.yml — lives ON THE APP SERVER (not the DGX Spark)

# LAN IP (or hostname) of the DGX Spark. Postgres and vLLM are both reached here.
DGX_HOST=192.168.1.100

# Must match the DGX Spark's Postgres credentials (see .env.dgx.example there)
POSTGRES_USER=manager_agent
POSTGRES_PASSWORD=manager_agent_pass
POSTGRES_DB=manager_agent_db

LLM_MODEL=qwen36-35B

# Origin(s) the frontend is served from, for backend CORS
CORS_ORIGINS=http://localhost:7008

# Backend URL the frontend (built as static assets) will call.
# Use this server's own reachable address, e.g. http://<app-server-ip>:7010
VITE_API_URL=http://localhost:7010

DEBUG=false
LOG_LEVEL=0
